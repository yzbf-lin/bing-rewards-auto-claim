{
  "manifest_version": 3,
  "name": "Bing Rewards 简单积分领取",
  "version": "0.3.1",
  "description": "每天识别、记录并执行一次即可完成的 Bing Rewards 积分入口。",
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://*.bing.com/*",
    "https://api.github.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.bing.com/*"
      ],
      "js": [
        "src/content/progress-overlay.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/popup/popup.html",
        "src/popup/popup.css",
        "src/popup/popup.js",
        "src/popup/model.js"
      ],
      "matches": [
        "https://*.bing.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Bing Rewards 简单积分领取",
    "default_popup": "src/popup/popup.html"
  }
}
